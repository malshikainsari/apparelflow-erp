# PostgreSQL connection string (Neon).
# Local development: use the direct connection.
# Vercel: use the pooled connection (host contains "-pooler") and append &connect_timeout=30
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# At least 32 random characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"
